# Settings for the VM stack (deploy/docker-compose.yml). Copy to deploy/.env (git-ignored).
# Run `node deploy/generate-keys.mjs` to fill in the three keys below. Never commit this file.

# --- Public address -----------------------------------------------------------
# The site's name (Caddy gets the certificate) and the address used in email links.
DOMAIN=pdot.example.com
SITE_URL=https://pdot.example.com
ACME_EMAIL=you@example.com

# --- Internal database and Supabase services -----------------------------------
# One password for Postgres and the Supabase service roles. Letters and digits only.
POSTGRES_PASSWORD=
# At least 32 characters. Signs every session token; changing it signs everyone out.
JWT_SECRET=
JWT_EXPIRY=3600
# Tokens signed with JWT_SECRET for the "anon" and "service_role" roles (generate-keys.mjs).
# The anon key is the app's publishable key. The service role key is never given to the app.
ANON_KEY=
SERVICE_ROLE_KEY=
# Close sign-up after the people you expect have accounts.
DISABLE_SIGNUP=false

# --- Email (optional) ----------------------------------------------------------
# Without SMTP, accounts are confirmed at sign-up and password reset cannot send mail.
ENABLE_EMAIL_AUTOCONFIRM=true
SMTP_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=P-Dot

# --- AI layer: Nebius Token Factory (inference) and Tavily (web search) -----------
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Leave empty to disable web search; the search toggle then reports that search is off.
TAVILY_API_KEY=
# Model routing (docs/decisions/0007-model-routing.md). Empty lines use the defaults.
NEBIUS_FAST_MODELS=
NEBIUS_STANDARD_MODELS=
NEBIUS_HEAVY_MODELS=
NEBIUS_VISION_MODELS=
NEBIUS_MAX_OUTPUT_TOKENS=
NEBIUS_STANDARD_MAX_OUTPUT_TOKENS=
NEBIUS_HEAVY_MAX_OUTPUT_TOKENS=
NEBIUS_HEAVY_THINKING_BUDGET=
NEBIUS_HEDGE_AFTER_MS=
# Spend caps for all users together (docs/decisions/0006-global-spend-guard.md).
NEBIUS_DAILY_CAP_USD=1.00
NEBIUS_TOTAL_CAP_USD=20.00
NEBIUS_USER_DAILY_CAP_USD=0.25
TAVILY_DAILY_CREDITS=40
TAVILY_MONTHLY_CREDITS=800
TAVILY_USER_DAILY_CREDITS=10
CHAT_REQUESTS_PER_WINDOW=30
CHAT_WINDOW_SECONDS=3600

# --- Local simulation on the VM (optional) ---------------------------------------
# To test the VM stack without spending, run Ollama on the host and set the chains to
# ollama/<model>, as in .env.docker.example. Leave empty in production.
OLLAMA_BASE_URL=
OLLAMA_EMBEDDING_MODEL=

# --- Ports (local checks only; Caddy is the public entry) ----------------------------
KONG_BIND=127.0.0.1
KONG_PORT=8000
APP_BIND=127.0.0.1
APP_PORT=3000
